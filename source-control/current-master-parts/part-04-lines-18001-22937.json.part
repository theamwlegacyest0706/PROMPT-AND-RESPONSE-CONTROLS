        ],
        [
          "Step",
          "Stage",
          "Controlled Requirement",
          null,
          "Control",
          "Means",
          "Does NOT Mean",
          "Safeguard"
        ],
        [
          "1",
          "Horse Eligibility / Welfare Screen",
          "Identify horses participating in the applicable cycle. A horse must be medically/welfare appropriate for ordinary participant interaction. A horse on rest, treatment or showing stress may be withheld without penalty or negative designation.",
          null,
          "Participants' Favorite Horse",
          "Participants choose the horse they personally favor from the eligible horse group.",
          "Best-looking horse; highest-value horse; fastest horse; most skilled horse; best pedigree; handler popularity contest.",
          "Preference itself is valid; no participant must justify it."
        ],
        [
          "2",
          "Participant Eligibility",
          "Define the participant group before voting opens. Eligible participants are people who actually participated in the applicable horse/equine experience during the cycle. Staff/handlers do not receive a ballot merely because of their role unless they independently qualify as participants under the pre-set cycle rule.",
          null,
          "PREPPIEST PONY name",
          "Playful recognition title.",
          "Eligibility limited to pony-sized animals or a conformation/grooming competition.",
          "Any eligible horse may win unless the Founder later creates a separate pony-only rule."
        ],
        [
          "3",
          "Reasonable Opportunity",
          "Participants should have a reasonable ordinary opportunity to know/interact with eligible horses during the cycle. Equal forced contact or identical time is not required; horse welfare and participant choice control.",
          null,
          "Horse as Honoree",
          "The horse receives the recognition.",
          "The handler/trainer automatically shares or owns the award.",
          "Handlers may be credited for care separately, but participant ballots select the horse."
        ],
        [
          "4",
          "No Campaigning / No Manufactured Preference",
          "Handlers, staff, families and supporters may not solicit votes, advertise one horse against another, repeatedly direct participants toward a horse, create special access, or use treats/rewards during the voting process to manufacture preference.",
          null,
          "Animal Welfare",
          "Horse comfort and welfare remain a gate before and after voting.",
          "A requirement that every horse be handled equally, displayed, decorated or kept available to secure votes.",
          "A horse may rest or be removed from the ballot for welfare without stigma."
        ],
        [
          "5",
          "Private Ballot",
          "Each eligible participant receives one private ballot and may select one eligible horse or abstain. No explanation, testimonial or public declaration is required.",
          null,
          "Participant Choice",
          "One eligible participant, one equal private ballot; abstention permitted.",
          "Social-media voting, donor voting, staff block voting, proxy voting or adult pressure on youth participants.",
          "Ballot privacy and equal voting weight are mandatory."
        ],
        [
          "6",
          "Secure Count",
          "Selection Records Steward and one independent verifier count valid ballots. Duplicate ballots, ineligible ballots and altered ballots are excluded and documented without blaming participants.",
          null,
          "Neutral Tie Rule",
          "Tie is resolved only by the pre-recorded neutral method.",
          "Selection Circle choosing the horse it prefers after seeing a tie.",
          "Tie procedure is recorded before ballots are opened."
        ],
        [
          "7",
          "Winner",
          "The eligible horse receiving the highest number of verified valid participant ballots is PREPPIEST PONY for that cycle.",
          null,
          null,
          null,
          null,
          null
        ],
        [
          "8",
          "Tie",
          "If two or more eligible horses share the highest verified ballot count, use the predetermined neutral tie-break method recorded before voting; no handler, staff member or Selection Circle member may choose based on personal preference.",
          null,
          null,
          null,
          null,
          null
        ],
        [
          "9",
          "Final Welfare Verification",
          "Before recognition, confirm the selected horse remains appropriate for participation/recognition. Recognition must not require costumes, handling, crowd exposure or presentation that compromises welfare.",
          null,
          null,
          null,
          null,
          null
        ],
        [
          "10",
          "Recognition / Return & Record",
          "Recognize the horse as the participants' favorite. Preserve aggregate ballot count, eligibility/welfare verification, tie procedure if used and process learning. Do not publish who voted for which horse.",
          null,
          null,
          null,
          null,
          null
        ],
        [
