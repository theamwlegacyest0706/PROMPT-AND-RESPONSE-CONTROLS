        [
          "1",
          "Establish Eligible Pool",
          "Best Trainer: people who materially trained Barclay during the evaluation period. Best Comfort Buddy: people with an established ordinary companionship relationship with Barclay. No one is eligible merely because of title, ownership, family relationship, donor status or visibility.",
          null,
          "Voluntary Approach",
          "Barclay freely approaches or re-approaches the person without pressure.",
          "Being carried/placed next to someone; blocked alternatives; repeated calling until he complies.",
          "Observe ordinary choice."
        ],
        [
          "2",
          "Welfare / Method Gate",
          "Confirm humane, safe treatment. Serious verified coercive, frightening, painful, reckless or welfare-compromising conduct makes the person ineligible for the cycle.",
          null,
          "Relaxation / Safety",
          "Loose comfortable posture, settled presence, normal breathing/behavior, ability to rest or disengage.",
          "Freezing, avoidance, appeasement, shutdown or stillness misread as comfort.",
          "Welfare-aware interpretation required."
        ],
        [
          "3",
          "No-Campaign / No-Influence Rule",
          "Nominees and supporters may not campaign to Barclay, repeatedly call him, monopolize him, stage interactions, create distress, or use special access/rewards to manufacture preference.",
          null,
          "Chosen Proximity",
          "Barclay chooses to remain near, follow, return to or settle with the person when alternatives exist.",
          "Leash restraint, closed-door confinement or food positioning treated as preference.",
          "Context must be recorded."
        ],
        [
          "4",
          "Ordinary Observation",
          "Observe Barclay across multiple ordinary interactions in familiar, low-pressure settings. Do not stage a head-to-head contest between nominees.",
          null,
          "Engagement",
          "Willing interaction appropriate to the relationship—training, play, touch or quiet companionship.",
          "Forced touch, crowding, repeated commands during a comfort observation, staged excitement/distress.",
          "Barclay may disengage at any time."
        ],
        [
          "5",
          "Barclay Choice Evidence",
          "Record voluntary approach, proximity, relaxed body language, willingness to remain/return, comfortable engagement, recovery after stimulation, responsiveness and freely chosen interaction. One isolated moment does not control the result.",
          null,
          "Trust / Recovery",
          "Barclay accepts guidance or comfort and returns toward baseline appropriately after ordinary stimulation.",
          "Creating fear/stress to demonstrate calming ability.",
          "Never manufacture distress."
